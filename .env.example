# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aoz_housing?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# =============================================================================
# AUTHENTICATION (not needed for pilot - configure before production)
# =============================================================================

# Session secret for encrypting cookies (generate with: openssl rand -base64 32)
# SESSION_SECRET="your-secret-key-here"

# Session duration in seconds (default: 8 hours)
# SESSION_DURATION="28800"

# Rate limiting for login attempts (requests per minute)
# LOGIN_RATE_LIMIT="10"

# Optional: AOZ SSO integration (if using external auth)
# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# SSO_ISSUER_URL=""
