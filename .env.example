# =============================================================================
# DATABASE (self-hosted PostgreSQL on Hetzner)
# =============================================================================

# Main connection URL
DATABASE_URL="postgresql://user:pass@localhost:5432/aoz_housing"

# Direct connection URL (for Prisma migrations). On self-hosted Postgres this
# is the same as DATABASE_URL; kept separate so schema.prisma's directUrl works.
DIRECT_URL="postgresql://user:pass@localhost:5432/aoz_housing"

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Session secret for JWT signing (generate with: openssl rand -base64 32)
# REQUIRED for production
SESSION_SECRET="your-secret-key-here"

# Session duration in seconds (default: 28800 = 8 hours)
SESSION_DURATION="28800"

# Max login attempts per 15-minute window (default: 10)
LOGIN_RATE_LIMIT="10"

# Secret for /api/cron/* routes (generate with: openssl rand -hex 32)
# REQUIRED in production — set as Authorization: Bearer <value> header
CRON_SECRET=""

# Initial admin account (used by prisma/seed-admin.ts)
# Change these before first deploy!
ADMIN_CODE="AOZ-ADMIN1"
ADMIN_NAME="Admin"
ADMIN_EMAIL=""

# =============================================================================
# EMAIL (Brevo — formerly Sendinblue)
# Get your API key at: https://app.brevo.com/settings/keys/api
# =============================================================================

# Brevo API key (leave empty to disable email — codes shown in UI instead)
BREVO_API_KEY=""

# Sender identity (must be verified in Brevo)
EMAIL_FROM_NAME="AOZ Housing"
EMAIL_FROM_ADDRESS="noreply@yourdomain.ch"

# Staff email addresses for system notifications (comma-separated)
# These receive daily summaries, incident alerts, transfer requests
STAFF_EMAIL_RECIPIENTS="staff@yourdomain.ch"

# =============================================================================
# AI ASSISTANT
#
# Set ONE of the two providers below. Form assistance (the "Aus Text ausfuellen"
# bar on the intake form) runs on whichever key is present — Groq wins if both
# are set. Without either, those endpoints answer 503 and the UI says so.
#
# The streaming chat assistant (/api/ai/chat) is Anthropic-only for now, so it
# needs ANTHROPIC_API_KEY specifically.
# =============================================================================

# Groq — free, and what every other app on the box uses.
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Anthropic — paid. https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# =============================================================================
# ERROR MONITORING (Sentry - optional)
# =============================================================================

# Runtime DSN (must start with NEXT_PUBLIC_ to be visible in browser bundle)
NEXT_PUBLIC_SENTRY_DSN=""

# Build-time source-map upload credentials. Only needed if you want Sentry
# stack traces to map back to TS source. All three required together.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# =============================================================================
# DEMO / PUBLIC ACCESS (optional — disable in production)
# =============================================================================

# When 'true', exposes a "Demo login" panel on /login. Production deploys
# should leave this disabled OR set DEMO_RESIDENT_CODE only (staff demo is
# always rejected in production by the server, see api/auth/demo/route.ts).
DEMO_ACCESS_ENABLED="false"
NEXT_PUBLIC_DEMO_ACCESS_ENABLED="false"

# Demo codes the panel will exchange for sessions. Must point to real
# AOZ-* / RES-* records in the database (see prisma/seed-demo.ts).
DEMO_STAFF_CODE=""
DEMO_RESIDENT_CODE=""

# =============================================================================
# APPLICATION
# =============================================================================

# Public-facing URL (used in invite email links)
NEXT_PUBLIC_APP_URL="https://your-app.example.com"

NODE_ENV="development"
