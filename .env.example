# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================

# Main connection URL (with connection pooling for app queries)
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/aoz_housing?sslmode=require"

# Direct connection URL (for Prisma migrations - bypasses pooler)
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/aoz_housing?sslmode=require"

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Session secret for JWT signing (generate with: openssl rand -base64 32)
# REQUIRED for production - the default dev secret is insecure
SESSION_SECRET="your-secret-key-here"

# Session duration in seconds (default: 28800 = 8 hours)
SESSION_DURATION="28800"

# Max login attempts per 15-minute window (default: 10)
LOGIN_RATE_LIMIT="10"

# Staff self-registration invite code (default: "0000")
STAFF_INVITE_CODE="0000"

# =============================================================================
# APPLICATION
# =============================================================================

# Public-facing URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Environment mode
NODE_ENV="development"

# =============================================================================
# ADMIN SEEDING (optional - for prisma/seed-admin.ts)
# =============================================================================

# Initial admin user credentials
# ADMIN_EMAIL="admin@aoz.ch"
# ADMIN_PASSWORD="changeme"
# ADMIN_NAME="Administrator"

# =============================================================================
# OPTIONAL: AOZ SSO Integration (if using external auth)
# =============================================================================

# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# SSO_ISSUER_URL=""
