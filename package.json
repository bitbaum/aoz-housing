{
  "name": "aoz-housing",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "description": "Support platform for refugee care work: housing stability with compatibility matching, daily-life coordination, conflict resolution, and learning & participation tracking — one system for staff and residents",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "jest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:seed:admin": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"types\":[\"node\"]}' prisma/seed-admin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register --compiler-options {\"module\":\"CommonJS\",\"types\":[\"node\"]} prisma/seed.ts"
  },
  "dependencies": {
    "@fleet/ai-forms": "github:bitbaum/ai-forms#v0.1.0",
    "@prisma/client": "^5.17.0",
    "@sentry/nextjs": "^10.71.0",
    "@types/bcryptjs": "^2.4.6",
    "ai-kit": "github:bitbaum/ai-kit#v0.6.2",
    "bcryptjs": "^3.0.3",
    "bip-kit": "^0.1.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.38.0",
    "marked": "14.1.4",
    "next": "^16.3.3",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prisma": "^5.17.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
